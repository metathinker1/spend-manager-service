# spend-manager-service settings — copy to .env.development / .env.production
# (both git-ignored) and adjust. Real environment variables override these files.
# The file is selected by SPEND_MANAGER_ENV (default: development).

# ---------------------------------------------------------------------------
# .env.development
# ---------------------------------------------------------------------------
# SPEND_MANAGER_ENV=development
# Local SQLite file (default: <project>/data/spend_manager.db)
# SPEND_MANAGER_DB_PATH=~/Project.SpendManager/spend-manager-data/dev/spend_manager.db
# Backups are off in development unless a folder is set:
# SPEND_MANAGER_BACKUP_DIR=
# MONEYWELL_STORE_ROOT=~/Project.SpendManager/MoneyWell_Data

# ---------------------------------------------------------------------------
# .env.production
# ---------------------------------------------------------------------------
# SPEND_MANAGER_ENV=production
# Required; must be outside Google Drive / iCloud / Dropbox (~/Library/CloudStorage)
# SPEND_MANAGER_DB_PATH=~/Project.SpendManager/spend-manager-data/prod/spend_manager.db
# Required; the folder is created on the first backup, its parent must exist
# SPEND_MANAGER_BACKUP_DIR=~/Google Drive/My Drive/SoftwareDevProjects/SpendManagerBackups
# Number of most recent backups to keep (plus the newest backup of every month)
# SPEND_MANAGER_BACKUP_KEEP=30
# MONEYWELL_STORE_ROOT=~/Project.SpendManager/MoneyWell_Data
